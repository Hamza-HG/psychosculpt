'wegwerfmail.de','spamgourmet.com','mintemail.com','grr.la','temp-mail.ru','yopmail.fr',
'yopmail.net','trashmail.net','trashmail.me','spambox.info','spambox.me','mailmetrash.com',
'maileater.com','spam.la','spam.su','nurfuerspam.de','0815.ru','armyspy.com','cuvox.de',
'dayrep.com','einrot.com','gustr.com','irish2me.com','jetable.com','kulturbetrieb.info',
'nincsmail.com','pookmail.com','rhyta.com','superrito.com','trashymail.com','veryrealemail.com'].forEach(
function(d){ DISPOSABLE[d] = true; });
function handleRequestOTP(data) {
  var email = (data.email || '').trim().toLowerCase();
  if (!email || !email.includes('@')) return respond(false, 'Invalid email.');
  var domain = email.split('@')[1];
  if (DISPOSABLE[domain]) return respond(false, 'Temporary emails not allowed.');
  var otp = String(Math.floor(1000 + Math.random() * 9000));
  var cache = CacheService.getScriptCache();
  cache.put('otp_' + email, otp, OTP_EXPIRY_MINUTES * 60);
  try {
    MailApp.sendEmail({
      to: email, subject: 'Your PsychoSculpt Verification Code', name: SENDER_NAME,
      htmlBody: '<div style="font-family:sans-serif;max-width:480px;margin:0 auto"><h2 style="color:#B30000">PsychoSculpt Books</h2><p>Your code:</p><div style="font-size:36px;letter-spacing:8px;font-weight:bold;color:#8B0000;text-align:center;padding:20px;background:#f5f5f5;border-radius:8px;margin:16px 0">' + otp + '</div><p>Expires in ' + OTP_EXPIRY_MINUTES + ' minutes.</p></div>' });
  } catch(e) { return respond(false, 'Failed to send email.'); }
  return respond(true, 'Code sent!');
}
function handleVerifyOTP(data) {
  var email = (data.email || '').trim().toLowerCase();
  var otp = (data.otp || '').trim();
  var cache = CacheService.getScriptCache();
  var stored = cache.get('otp_' + email);
  if (!stored) return respond(false, 'No code found. Request a new one.');
  if (stored !== otp) return respond(false, 'Invalid code.');
  cache.remove('otp_' + email);
  // Save email to Google Sheet (if SHEET_ID is configured)
  if (SHEET_ID) {
    try {
      var sheet = SpreadsheetApp.openById(SHEET_ID).getActiveSheet();
      sheet.appendRow([new Date(), email, data.bookId || 'default']);
    } catch(e) {}
  }
  // Send welcome email
  try {
    MailApp.sendEmail({
      to: email, subject: 'Welcome to PsychoSculpt Books!', name: SENDER_NAME,
      htmlBody: '<div style="font-family:sans-serif;max-width:480px;margin:0 auto"><h2 style="color:#B30000">Welcome to PsychoSculpt Books</h2><p>Your access has been verified. Happy reading!</p><p style="font-size:12px;color:#999">You received this because you verified your email on our site.</p></div>' });
  } catch(e) {}
  var url = BOOK_URLS[data.bookId] || BOOK_URLS.default;
  return respond(true, 'Access granted!', { url: url });
}
function respond(success, message, extra) {
  extra = extra || {};
  var result = { success: success, message: message };
  for (var k in extra) result[k] = extra[k];
  return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}
