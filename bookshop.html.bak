    <script>
        // ── Sticky header ──
        const header = document.getElementById('header');
        window.addEventListener('scroll', () => {
            header.classList.toggle('scrolled', window.scrollY > 60);
        });

        // ── Scroll reveal ──
        const reveals = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, i) => {
                if (entry.isIntersecting) {
                    setTimeout(() => entry.target.classList.add('active'), i * 60);
                }
            });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(el => observer.observe(el));

        // ── Search ──
        const searchInput = document.getElementById('searchInput');
        const cards = document.querySelectorAll('.book-card');

        function filterCards() {
            const q = searchInput.value.toLowerCase();
            const activePill = document.querySelector('.pill.active');
            const activeFilter = activePill ? activePill.dataset.filter : 'all';

            cards.forEach(card => {
                const title = (card.dataset.title || '').toLowerCase();
                const author = (card.dataset.author || '').toLowerCase();
                const category = (card.dataset.category || '').toLowerCase();
                const tags = card.dataset.tags || '';
                const searchText = title + ' ' + author + ' ' + category + ' ' + tags;
                const matchSearch = !q || searchText.includes(q);
                const matchFilter = activeFilter === 'all' || tags.includes(activeFilter);
                card.style.display = (matchSearch && matchFilter) ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', filterCards);

        // ── Filter pills ──
        document.querySelectorAll('.pill').forEach(pill => {
            pill.addEventListener('click', () => {
                document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
                pill.classList.add('active');
                filterCards();
            });
        });

        // ── Book Detail Modal ──
        const bookModal = document.getElementById('bookModal');
        const modalPanel = document.getElementById('modalPanel');
        let scrollY = 0;

        function openBookModal(card) {
            // Populate modal
            document.getElementById('modalImg').src = card.dataset.img || '';
            document.getElementById('modalImg').alt = card.dataset.title || '';
            document.getElementById('modalCategory').textContent = card.dataset.category || '';
            document.getElementById('modalTitle').textContent = card.dataset.title?.replace(/ by .*$/, '') || '';
            document.getElementById('modalAuthor').textContent = 'by ' + (card.dataset.author || '');
            document.getElementById('modalRating').textContent = card.dataset.rating || '';
            document.getElementById('modalRatingCount').textContent = '(' + (card.dataset.ratingcount || '') + ')';
            document.getElementById('modalDesc').textContent = card.dataset.desc || '';

            // Formats
            const formatsEl = document.getElementById('modalFormats');
            formatsEl.innerHTML = '';
            (card.dataset.formats || '').split('·').forEach(f => {
                const b = document.createElement('span');
                b.className = 'format-badge';
                b.textContent = f.trim();
                formatsEl.appendChild(b);
            });

            // Tags
            const tagsEl = document.getElementById('modalTags');
            tagsEl.innerHTML = '';
            (card.dataset.taglist || '').split('·').forEach(t => {
                const span = document.createElement('span');
                span.className = 'modal-tag';
                span.textContent = t.trim();
                tagsEl.appendChild(span);
            });

            // Actions
            const actionsEl = document.getElementById('modalActions');
            actionsEl.innerHTML = `
            <button class="btn-primary" onclick="_GK()">
                <i class="fas fa-lock"></i> Verify and Download
            </button>
            <a href="#contact" class="btn-ghost" onclick="closeBookModal()">
                <i class="fas fa-envelope"></i> Request Format
            </a>
        `;

            // Open with body lock
            scrollY = window.scrollY;
            document.body.style.overflow = 'hidden';
            document.body.style.position = 'fixed';
            document.body.style.top = `-${scrollY}px`;
            document.body.style.width = '100%';
            bookModal.classList.add('open');
        }

        function closeBookModal() {
            bookModal.classList.remove('open');
            document.body.style.overflow = '';
            document.body.style.position = '';
            document.body.style.top = '';
            document.body.style.width = '';
            window.scrollTo(0, scrollY);
        }

        // Close on Escape key
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                if (document.getElementById('otpModal').classList.contains('open')) {
                    closeOTPModal();
                } else {
                    closeBookModal();
                }
            }
        });

        // Expose globally
        window.openBookModal = openBookModal;
        window.closeBookModal = closeBookModal;

        // ── 3D tilt & sheen on book cards ──
        cards.forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const r = card.getBoundingClientRect();
                const x = ((e.clientX - r.left) / r.width - 0.5) * 12;
                const y = ((e.clientY - r.top) / r.height - 0.5) * -12;

                const sx = ((e.clientX - r.left) / r.width) * 100;
                const sy = ((e.clientY - r.top) / r.height) * 100;

                card.style.transform = `translateY(-6px) perspective(600px) rotateX(${y}deg) rotateY(${x}deg)`;
                card.style.setProperty('--sheen-x', `${sx}%`);
                card.style.setProperty('--sheen-y', `${sy}%`);
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = '';
            });
        });

        // ── 3D Scroll-Driven Animation Controller ──
        const heroSection = document.querySelector('.hero');
        const heroBooks = document.querySelectorAll('.stack-card-3d');
        const featuredSection = document.querySelector('.featured-banner');
        const featuredBook = document.querySelector('.featured-book-3d');
        const featuredCover = featuredBook ? featuredBook.querySelector('.book-3d-front') : null;

        let isHeroVisible = true;
        let isFeaturedVisible = false;

        // High-performance visibility tracking
        const visibilityObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.target === heroSection) {
                    isHeroVisible = entry.isIntersecting;
                } else if (entry.target === featuredSection) {
                    isFeaturedVisible = entry.isIntersecting;
                }
            });
        }, { threshold: 0.02 });

        if (heroSection) visibilityObserver.observe(heroSection);
        if (featuredSection) visibilityObserver.observe(featuredSection);

        // Optimized animation frame throttle
        let tick = false;
        window.addEventListener('scroll', () => {
            if (!tick) {
                requestAnimationFrame(() => {
                    updateScrollAnimations();
                    tick = false;
                });
                tick = true;
            }
        }, { passive: true });

        function updateScrollAnimations() {
            const scrollTop = window.scrollY;

            // 1. Hero stack fanning on scroll
            if (isHeroVisible && heroSection) {
                const heroHeight = heroSection.offsetHeight;
                const progress = Math.min(1, Math.max(0, scrollTop / heroHeight));

                heroBooks.forEach((book, index) => {
                    if (index === 0) { // Back Book
                        book.style.setProperty('--scroll-drift-x', `${progress * -90}px`);
                        book.style.setProperty('--scroll-drift-y', `${progress * 25}px`);
                        book.style.setProperty('--scroll-drift-z', `${progress * -50}px`);
                        book.style.setProperty('--scroll-rot-y', `${progress * 16}deg`);
                        book.style.setProperty('--scroll-rot-z', `${progress * 3}deg`);
                    } else if (index === 1) { // Middle Book
                        book.style.setProperty('--scroll-drift-x', `${progress * 15}px`);
                        book.style.setProperty('--scroll-drift-y', `${progress * -30}px`);
                        book.style.setProperty('--scroll-drift-z', `${progress * -20}px`);
                        book.style.setProperty('--scroll-rot-x', `${progress * 8}deg`);
                        book.style.setProperty('--scroll-rot-y', `${progress * -4}deg`);
                    } else if (index === 2) { // Front Book
                        book.style.setProperty('--scroll-drift-x', `${progress * 110}px`);
                        book.style.setProperty('--scroll-drift-y', `${progress * 30}px`);
                        book.style.setProperty('--scroll-drift-z', `${progress * 50}px`);
                        book.style.setProperty('--scroll-rot-y', `${progress * -18}deg`);
                        book.style.setProperty('--scroll-rot-z', `${progress * -5}deg`);
                    }
                });
            }

            // 2. Featured book cover opening on scroll
            if (isFeaturedVisible && featuredSection && featuredCover && featuredBook) {
                const rect = featuredSection.getBoundingClientRect();
                const viewHeight = window.innerHeight;

                // Progress: 0 when banner enters viewport, 1 when it leaves
                const entryProgress = (viewHeight - rect.top) / (viewHeight + rect.height);
                const progress = Math.min(1, Math.max(0, entryProgress));

                // Map progress [0.15, 0.55] to [0, 1] for opening
                let openProgress = 0;
                if (progress > 0.15) {
                    openProgress = Math.min(1, (progress - 0.15) / 0.4);
                }

                const openAngle = openProgress * -130;
                featuredCover.style.setProperty('--book-cover-open', `${openAngle}deg`);

                // Spine rotates slightly forward as it opens
                const yRot = -20 + (openProgress * 22);
                const xRot = 15 - (openProgress * 5);
                featuredBook.style.transform = `rotateY(${yRot}deg) rotateX(${xRot}deg) rotateZ(-3deg)`;
            }
        }

        // ── On load: if already verified, show badge and hide preloader early ──
        document.addEventListener('DOMContentLoaded', function () {
            if (localStorage.getItem('psycho_sculpt_verified') === 'true') {
                document.body.classList.add('verified-user');
                // Add verified badge to nav
                const nav = document.querySelector('.nav-inner');
                if (nav && !document.getElementById('verified-badge')) {
                    const badge = document.createElement('div');
                    badge.id = 'verified-badge';
                    badge.style.cssText = 'display:flex;align-items:center;gap:6px;background:rgba(139,0,0,0.15);border:1px solid var(--border-hot);padding:4px 12px;border-radius:4px;font-size:0.7rem;font-family:DM Mono,monospace;letter-spacing:0.1em;color:var(--red-300);text-transform:uppercase';
                    badge.innerHTML = '<i class="fas fa-check-circle" style="color:var(--red-400)"></i> Verified';
                    nav.appendChild(badge);
                }
            }
        });

        // ── Preloader Progress Simulation ──
        const preloaderEl = document.getElementById('preloader');
        const percentEl = document.getElementById('preloader-percent');
        const barEl = document.querySelector('.preloader-bar');

        let count = 0;
        const interval = setInterval(() => {
            count += Math.floor(Math.random() * 8) + 3;
            if (count >= 100) {
                count = 100;
                clearInterval(interval);
                percentEl.textContent = count;
                barEl.style.width = '100%';
                setTimeout(() => {
                    preloaderEl.classList.add('loaded');
                    document.body.style.overflow = '';
                }, 500);
            } else {
                percentEl.textContent = count.toString().padStart(2, '0');
                barEl.style.width = `${count}%`;
            }
        }, 55);

        // ── Magnetic Button Physics Listener ──
        const magneticBtns = document.querySelectorAll('.btn-primary, .nav-cta, .submit-btn, .dl-btn-primary, .dl-btn-secondary');
        magneticBtns.forEach(btn => {
            btn.addEventListener('mousemove', (e) => {
                const r = btn.getBoundingClientRect();
                const x = e.clientX - (r.left + r.width / 2);
                const y = e.clientY - (r.top + r.height / 2);
                btn.style.transform = `translate(${x * 0.12}px, ${y * 0.12}px)`;
            });
            btn.addEventListener('mouseleave', () => {
                btn.style.transform = '';
            });
        });

        // ── Multi-Layer Parallax Background Orbs ──
        const orb1 = document.querySelector('.orb-1');
        const orb2 = document.querySelector('.orb-2');
        const orb3 = document.querySelector('.orb-3');

        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;

            if (orb1) orb1.style.transform = `translateY(${scrollTop * 0.22}px)`;
            if (orb2) orb2.style.transform = `translateY(${scrollTop * -0.12}px)`;
            if (orb3) orb3.style.transform = `translateY(${scrollTop * 0.35}px) translateX(${scrollTop * 0.08}px)`;
        }, { passive: true });

        // ── Interactive Tip Card Logic ──
        const tips = [
            {
                name: "The Door-in-the-Face Technique",
                desc: "Making an extreme demand that will certainly be refused, followed by a smaller, more reasonable request (the actual goal).",
                defense: "Recognize the contrast principle. Treat the second request in isolation, not as a concession."
            },
            {
                name: "Gaslighting",
                desc: "Denying reality or twisting facts to make the victim doubt their own memory, perception, or sanity.",
                defense: "Document events as they happen. Trust your gut. Do not engage in arguments over established facts."
            },
            {
                name: "Love Bombing",
                desc: "Overwhelming someone with signs of adoration and attraction to gain control or make them dependent.",
                defense: "Set strict boundaries early. If a relationship accelerates unnaturally fast, forcefully slow the pace."
            },
            {
                name: "Triangulation",
                desc: "Bringing a third person into a dynamic to create rivalry, jealousy, and shift the balance of power.",
                defense: "Communicate directly with all parties involved. Refuse to participate in indirect, back-channel conversations."
            },
            {
                name: "The False Choice",
                desc: "Presenting two options as the only possibilities, when in fact there are many, to force a desired outcome.",
                defense: "Step back and identify the unstated options. Say 'neither of those work for me, let's explore other avenues.'"
            }
        ];

        let currentTipIndex = 0;
        const tipNameEl = document.getElementById('tip-name');
        const tipDescEl = document.getElementById('tip-desc');
        const tipDefenseEl = document.getElementById('tip-defense');
        const tipCardBody = document.querySelector('.tip-body');

        function nextTip() {
            if (!tipCardBody) return;

            tipCardBody.classList.add('tip-fade-out');

            setTimeout(() => {
                currentTipIndex = (currentTipIndex + 1) % tips.length;
                const tip = tips[currentTipIndex];

                tipNameEl.textContent = tip.name;
                tipDescEl.textContent = tip.desc;
                tipDefenseEl.textContent = tip.defense;

                tipCardBody.classList.remove('tip-fade-out');
            }, 400);
        }

        window.nextTip = nextTip;
        // ── Secure OTP Verification Logic ──
        // Replace with your deployed Google Apps Script Web App URL:
        // 1. Open https://script.google.com/ → New Project
        // 2. Paste the code from OTP_Backend.gs (in this folder)
        // 3. Deploy → New Deployment → Web App → "Anyone"
        // 4. Copy the URL and paste it below
        const API_URL = 'https://script.google.com/macros/s/AKfycbydWJkPgLhyQL-h7z4PdjdvREVH56B7pT2trlaFpXzgyoRHghl_TGXcaqN4yxZM9YaY/exec';

        let currentBookId = '';
        let currentEmail = '';

        function openOTPModal(bookId, bookTitle) {
            // If already verified, grant access immediately
            if (localStorage.getItem('psycho_sculpt_verified') === 'true') {
                window.location.href = 'https://psychosculpt5.blogspot.com/?m=1#';
                return;
            }
            currentBookId = bookId;
            document.getElementById('otp-book-title').textContent = bookTitle || 'Library Access';

            // Ensure standard modal is closed if open
            const standardModal = document.getElementById('bookModal');
            if (standardModal.classList.contains('open')) {
                standardModal.classList.remove('open');
            }

            document.getElementById('otpModal').classList.add('open');
            document.body.style.overflow = 'hidden';
            resetOTP();
        }

        function closeOTPModal() {
            document.getElementById('otpModal').classList.remove('open');
            document.body.style.overflow = '';
        }

        function resetOTP() {
            document.getElementById('otp-step-1').style.display = 'block';
            document.getElementById('otp-step-2').style.display = 'none';
            document.getElementById('otp-step-3').style.display = 'none';
            document.getElementById('otp-error').textContent = '';
            document.getElementById('user-email').value = '';
            document.querySelectorAll('.otp-box').forEach(b => b.value = '');
        }

        function focusNext(el) {
            if (el.value.length === 1) {
                let next = el.nextElementSibling;
                if (next && next.classList.contains('otp-box')) next.focus();
            }
        }

        const DISPOSABLE_DOMAINS = new Set([
            'mailinator.com', 'guerrillamail.com', 'temp-mail.org', '10minutemail.com',
            'yopmail.com', 'trashmail.com', 'maildrop.cc', 'getnada.com', 'throwaway.email',
            'sharklasers.com', 'burnermail.io', 'tempmail.net', 'fakeinbox.com',
            'mailnator.com', 'spambox.us', 'dispostable.com', 'mailexpire.com',
            'mytemp.email', 'jetable.org', 'mailsac.com', 'mailcatch.com', 'e4ward.com',
            'discard.email', 'wegwerfmail.de', 'spamgourmet.com', 'mintemail.com',
            'guerrillamail.net', 'guerrillamail.org', 'guerrillamail.biz', 'grr.la',
            'temp-mail.ru', '10minutemail.net', 'throwamail.com', 'yopmail.fr',
            'yopmail.net', 'trashmail.net', 'trashmail.me', 'spambox.info', 'spambox.me',
            'mailmetrash.com', 'maileater.com', 'spam.la', 'spam.su', 'nurfuerspam.de',
            '0815.ru', 'armyspy.com', 'cuvox.de', 'dayrep.com', 'einrot.com', 'fleckens.hu',
            'gustr.com', 'irish2me.com', 'jetable.com', 'kulturbetrieb.info', 'nincsmail.com',
            'pookmail.com', 'rhyta.com', 'superrito.com', 'trashymail.com', 'veryrealemail.com'
        ]);

        async function sendOTP() {
            const email = document.getElementById('user-email').value;
            const btn = document.getElementById('btn-send-otp');
            const err = document.getElementById('otp-error');

            if (!email || !email.includes('@')) { err.textContent = 'Please enter a valid email.'; return; }

            const domain = email.split('@')[1].toLowerCase();
            if (DISPOSABLE_DOMAINS.has(domain)) {
                err.textContent = 'Temporary emails are not allowed. Please use a real email address.';
                return;
            }

            currentEmail = email;
            err.textContent = '';
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating Secure Code...';
            btn.disabled = true;

            try {
                // Fallback for demo mode (if API_URL is untouched)
                if (API_URL.includes('YOUR_SCRIPT_ID')) {
                    setTimeout(() => showOTPStep2(email, btn), 1500);
                    return;
                }

                const res = await fetch(API_URL, {
                    method: 'POST',
                    body: JSON.stringify({ action: 'requestOTP', email: email }),
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' } // Apps Script CORS workaround
                });
                const data = await res.json();

                if (data.success) {
                    showOTPStep2(email, btn);
                } else {
                    err.textContent = 'Failed to send code. Try again.';
                    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Verification Code';
                    btn.disabled = false;
                }
            } catch (e) {
                setTimeout(() => showOTPStep2(email, btn), 1500); // Demo fallback
            }
        }

        function showOTPStep2(email, btn) {
            btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Verification Code';
            btn.disabled = false;
            document.getElementById('sent-email-display').textContent = email;
            document.getElementById('otp-step-1').style.display = 'none';
            document.getElementById('otp-step-2').style.display = 'block';
            document.querySelector('.otp-box').focus();
        }

        async function verifyOTP() {
            const boxes = document.querySelectorAll('.otp-box');
            let code = '';
            boxes.forEach(b => code += b.value);

            const btn = document.getElementById('btn-verify-otp');
            const err = document.getElementById('otp-error');

            if (code.length < 4) { err.textContent = 'Enter the complete 4-digit code.'; return; }

            err.textContent = '';
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verifying Code...';
            btn.disabled = true;

            try {
                // Fallback for demo mode
                if (API_URL.includes('YOUR_SCRIPT_ID')) {
                    setTimeout(() => grantAccess('https://psychosculpt5.blogspot.com/?m=1#', btn), 1500);
                    return;
                }

                const res = await fetch(API_URL, {
                    method: 'POST',
                    body: JSON.stringify({ action: 'verifyOTP', email: currentEmail, otp: code, bookId: currentBookId }),
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' }
                });
                const data = await res.json();

                if (data.success && data.url) {
                    grantAccess(data.url, btn);
                } else {
                    err.textContent = 'Invalid or expired code.';
                    btn.innerHTML = '<i class="fas fa-unlock-alt"></i> Verify & Unlock Book';
                    btn.disabled = false;
                }
            } catch (e) {
                setTimeout(() => grantAccess('https://psychosculpt5.blogspot.com/?m=1#', btn), 1500); // Demo fallback
            }
        }

        function grantAccess(url, btn) {
            document.getElementById('otp-step-2').style.display = 'none';
            document.getElementById('otp-step-3').style.display = 'block';

            localStorage.setItem('psycho_sculpt_verified', 'true');
            localStorage.setItem('redirectAfterOffer', btoa(url));
            setTimeout(() => {
                if (typeof _GK === 'function') { _GK(); }
                else if (typeof _KB === 'function') { _KB(); }
                else { window.location.href = url; }
            }, 1500);
        }

        // ── openOTPFromCard: read card data attrs and open OTP modal ──
        function openOTPFromCard(btn) {
            // If already verified, skip OTP and go directly
            if (localStorage.getItem('psycho_sculpt_verified') === 'true') {
                window.location.href = 'https://psychosculpt5.blogspot.com/?m=1#';
                return;
            }
            const card = btn.closest('.book-card');
            if (!card) return;
            const title = card.dataset.title || 'Library Access';
            const id = 'book_' + title.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase();
            openOTPModal(id, title);
        }

        // ── Mobile hamburger toggle ──
        function toggleMobileMenu() {
            document.querySelector('.nav-links').classList.toggle('active');
        }
        // Close mobile menu on link click
        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', () => {
                document.querySelector('.nav-links')?.classList.remove('active');
            });
        });

        // ── Category auto-filter ──
        function applyFilter(filter) {
            const pills = document.querySelectorAll('.pill');
            pills.forEach(p => {
                p.classList.toggle('active', p.dataset.filter === filter);
            });
            filterCards();
            document.getElementById('books').scrollIntoView({ behavior: 'smooth' });
        }

        // ── Sorting ──
        document.getElementById('sortSelect')?.addEventListener('change', function () {
            const sort = this.value;
            if (!sort) return;
            const grid = document.getElementById('appContainer');
            const items = Array.from(grid.querySelectorAll('.book-card'));
            items.sort((a, b) => {
                if (sort === 'title') {
                    return (a.dataset.title || '').localeCompare(b.dataset.title || '');
                }
                if (sort === 'rating') {
                    const getRating = (card) => {
                        const m = (card.dataset.ratingcount || '').match(/[\d.]+/);
                        return m ? parseFloat(m[0]) : 0;
                    };
                    return getRating(b) - getRating(a);
                }
                return 0;
            });
            items.forEach(item => grid.appendChild(item));
        });

        // ── Back to top ──
        const backToTopBtn = document.getElementById('backToTop');
        if (backToTopBtn) {
            window.addEventListener('scroll', () => {
                backToTopBtn.style.display = window.scrollY > 400 ? 'block' : 'none';
            }, { passive: true });
        }

        // Expose functions globally
        window.openOTPModal = openOTPModal;
        window.closeOTPModal = closeOTPModal;
        window.sendOTP = sendOTP;
        window.verifyOTP = verifyOTP;
        window.resetOTP = resetOTP;
        window.focusNext = focusNext;
        window.openOTPFromCard = openOTPFromCard;
        window.toggleMobileMenu = toggleMobileMenu;
        window.applyFilter = applyFilter;
    </script>

    <!-- MOBILE STICKY CONVERSION BAR (Core Web Vitals & CRO) -->
    <div class="mobile-sticky-bar" id="mobileStickyBar">
        <div class="mobile-sticky-info">
            <span class="mobile-sticky-title">Dark Psychology Library</span>
            <span class="mobile-sticky-sub">50+ Books · Free Digital Access</span>
        </div>
        <a href="#books" class="mobile-sticky-btn">
            <i class="fas fa-layer-group"></i> Browse Library
        </a>
    </div>

</body>

</html>

