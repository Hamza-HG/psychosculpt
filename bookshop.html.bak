        /* ── SEO KNOWLEDGE BASE & CONTENT SECTIONS ── */
        .seo-section {
            padding: 80px 40px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .seo-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            margin-bottom: 40px;
        }

        .seo-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 36px 32px;
            position: relative;
            transition: border-color 0.3s ease, transform 0.3s ease;
        }

        .seo-card:hover {
            border-color: var(--border-hot);
            transform: translateY(-2px);
        }

        .seo-card h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            color: var(--text);
            margin-bottom: 16px;
            line-height: 1.2;
        }

        .seo-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.7;
            margin-bottom: 16px;
        }

        .seo-card p:last-child {
            margin-bottom: 0;
        }

        .seo-highlight-box {
            background: rgba(61, 0, 0, 0.35);
            border-left: 3px solid var(--red-500);
            padding: 16px 20px;
            border-radius: 0 6px 6px 0;
            margin: 20px 0;
            font-size: 0.92rem;
            color: var(--text);
            line-height: 1.6;
        }

        .triad-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-top: 20px;
        }

        .triad-item {
            background: rgba(10, 2, 2, 0.7);
            border: 1px solid rgba(139, 0, 0, 0.2);
            border-radius: 6px;
            padding: 16px;
        }

        .triad-item h4 {
            color: var(--gold-light);
            font-size: 0.85rem;
            font-family: 'DM Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 8px;
        }

        .triad-item p {
            font-size: 0.82rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin: 0;
        }

        /* ── TACTICS ORDERED LIST (GOOGLE SNIPPET BAIT) ── */
        .tactics-list-wrap {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 40px;
            margin-bottom: 40px;
        }

        .tactics-ol {
            list-style: none;
            counter-reset: tactics-counter;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .tactic-item {
            counter-increment: tactics-counter;
            display: flex;
            gap: 16px;
            background: rgba(15, 3, 3, 0.5);
            border: 1px solid rgba(139, 0, 0, 0.2);
            border-radius: 6px;
            padding: 20px;
            transition: border-color 0.3s;
        }

        .tactic-item:hover {
            border-color: var(--red-700);
        }

        .tactic-num {
            font-family: 'DM Mono', monospace;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--red-400);
            background: rgba(139, 0, 0, 0.2);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .tactic-content h4 {
            font-size: 1.05rem;
            color: var(--text);
            margin-bottom: 6px;
        }

        .tactic-content p {
            font-size: 0.88rem;
            color: var(--text-muted);
            line-height: 1.55;
            margin-bottom: 8px;
        }

        .tactic-defense {
            font-size: 0.8rem;
            color: var(--gold);
            font-family: 'DM Mono', monospace;
        }

        /* ── COMPARISON TABLE ── */
        .comp-table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 40px;
        }

        .comp-table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .comp-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
            text-align: left;
            min-width: 720px;
        }

        .comp-table th {
            background: rgba(28, 5, 5, 0.95);
            color: var(--text);
            padding: 18px 20px;
            font-family: 'DM Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            border-bottom: 2px solid var(--red-700);
        }

        .comp-table td {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(139, 0, 0, 0.15);
            color: var(--text-muted);
            vertical-align: middle;
        }

        .comp-table tr:hover td {
            background: rgba(60, 10, 10, 0.25);
            color: var(--text);
        }

        .comp-table .book-title-cell {
            font-weight: 500;
            color: var(--text);
        }

        .comp-table .stars-col {
            color: var(--gold);
        }

        .comp-tag {
            display: inline-block;
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 3px;
            background: rgba(139, 0, 0, 0.25);
            color: var(--red-300);
            border: 1px solid rgba(139, 0, 0, 0.4);
        }

        /* ── FAQ ACCORDIONS (ZERO-JS NATIVE DETAILS) ── */
        .faq-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 40px;
        }

        details.faq {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px 24px;
            transition: all 0.3s ease;
        }

        details.faq[open] {
            border-color: var(--border-hot);
            background: rgba(25, 5, 5, 0.9);
        }

        details.faq summary {
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            font-size: 0.98rem;
            color: var(--text);
            cursor: pointer;
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            user-select: none;
        }

        details.faq summary::-webkit-details-marker {
            display: none;
        }

        details.faq summary::after {
            content: '\f078';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            font-size: 0.75rem;
            color: var(--red-400);
            transition: transform 0.3s ease;
            flex-shrink: 0;
        }

        details.faq[open] summary::after {
            transform: rotate(180deg);
        }

        details.faq .faq-answer {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid rgba(139, 0, 0, 0.2);
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.65;
        }

        /* ── E-E-A-T & DISCLAIMER ── */
        .eeat-card {
            background: rgba(18, 4, 4, 0.6);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 32px;
            margin-bottom: 40px;
        }

        .eeat-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        .eeat-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(139, 0, 0, 0.15);
            border: 1px solid rgba(139, 0, 0, 0.3);
            border-radius: 4px;
            padding: 10px 16px;
            font-size: 0.8rem;
            color: var(--text);
            font-family: 'DM Mono', monospace;
        }

        .eeat-badge i {
            color: var(--gold);
        }

        .disclaimer-box {
            background: rgba(10, 0, 0, 0.8);
            border-left: 3px solid var(--gold);
            padding: 18px 24px;
            border-radius: 0 6px 6px 0;
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.6;
        }

        .disclaimer-box strong {
            color: var(--text);
        }

        .disclaimer-box a {
            color: var(--gold-light);
            text-decoration: underline;
        }

        /* ── MOBILE STICKY BOTTOM BAR ── */
        .mobile-sticky-bar {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 998;
            background: rgba(10, 1, 1, 0.96);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-top: 1px solid var(--border-hot);
            padding: 12px 18px;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.8);
        }

        .mobile-sticky-info {
            display: flex;
            flex-direction: column;
        }

        .mobile-sticky-title {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text);
        }

        .mobile-sticky-sub {
            font-size: 0.68rem;
            color: var(--text-muted);
            font-family: 'DM Mono', monospace;
        }

        .mobile-sticky-btn {
            background: linear-gradient(135deg, var(--red-700), var(--red-500));
            color: white;
            padding: 9px 18px;
            border-radius: 4px;
            font-size: 0.78rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        @media (max-width: 768px) {
            .seo-grid-2,
            .tactics-ol,
            .faq-grid,
            .triad-grid {
                grid-template-columns: 1fr;
            }

            .seo-section {
                padding: 60px 16px;
            }

            .tactics-list-wrap,
            .eeat-card,
            .seo-card {
                padding: 24px 18px;
            }

            .mobile-sticky-bar {
                display: flex;
            }
        }
    </style>

