        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        :root {
            --red-900: #3D0000;
            --red-800: #5C0000;
            --red-700: #8B0000;
            --red-600: #B30000;
            --red-500: #D40000;
            --red-400: #FF2222;
            --red-300: #FF6666;
            --red-glow: rgba(180, 0, 0, 0.35);
            --bg: #060606;
            --bg-2: #0D0000;
            --surface: rgba(20, 4, 4, 0.8);
            --surface-2: rgba(40, 8, 8, 0.6);
            --border: rgba(139, 0, 0, 0.25);
            --border-hot: rgba(212, 0, 0, 0.6);
            --text: #F0E6E6;
            --text-muted: #9A7070;
            --text-dim: #5A3A3A;
            --gold: #C9A84C;
            --gold-light: #E8C96A;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            color: var(--text);
            background: var(--bg);
            overflow-x: hidden;
            cursor: default;
        }

        /* ── NOISE TEXTURE ── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 9999;
            opacity: 0.4;
        }

        /* ── SCROLLBAR ── */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--red-700);
            border-radius: 2px;
        }

        /* ── TYPOGRAPHY ── */
        .serif {
            font-family: 'Cormorant Garamond', serif;
        }

        .mono {
            font-family: 'DM Mono', monospace;
        }

        /* Liquid-Foil Text Shimmer */
        .serif em,
        .sec-title em,
        .contact-info h2 em,
        .footer-brand em {
            background: linear-gradient(90deg, var(--red-400) 0%, #ffffff 25%, var(--red-400) 50%, var(--red-500) 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: text-shimmer 6s linear infinite;
            font-style: italic;
        }

        @keyframes text-shimmer {
            0% {
                background-position: 200% center;
            }

            100% {
                background-position: -200% center;
            }
        }

        /* ── PRELOADER CURTAIN ── */
        .preloader {
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: #060606;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 1.2s cubic-bezier(0.85, 0, 0.15, 1);
        }

        .preloader.loaded {
            transform: translateY(-100%);
        }

        .preloader-inner {
            text-align: center;
        }

        .preloader-logo {
            font-size: 3rem;
            background: linear-gradient(135deg, var(--red-700), var(--red-400));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: pulse-logo 2s infinite ease-in-out;
            margin-bottom: 24px;
        }

        .preloader-bar-wrap {
            width: 160px;
            height: 2px;
            background: rgba(139, 0, 0, 0.1);
            margin: 0 auto 16px;
            border-radius: 1px;
            overflow: hidden;
            position: relative;
        }

        .preloader-bar {
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 0%;
            background: var(--red-600);
            box-shadow: 0 0 10px var(--red-400);
            transition: width 0.1s linear;
        }

        .preloader-text {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            color: var(--text-muted);
        }

        @keyframes pulse-logo {

            0%,
            100% {
                transform: scale(1);
                opacity: 0.8;
                filter: drop-shadow(0 0 5px rgba(212, 0, 0, 0));
            }

            50% {
                transform: scale(1.08);
                opacity: 1;
                filter: drop-shadow(0 0 15px rgba(212, 0, 0, 0.5));
            }
        }

        /* ── ANIMATIONS ── */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @keyframes pulse-glow {

            0%,
            100% {
                box-shadow: 0 0 20px var(--red-glow);
            }

            50% {
                box-shadow: 0 0 50px var(--red-glow), 0 0 80px rgba(180, 0, 0, 0.15);
            }
        }

        @keyframes ticker {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0px) rotate(0deg);
            }

            50% {
                transform: translateY(-8px) rotate(1deg);
            }
        }

        @keyframes shimmer {
            0% {
                left: -100%;
            }

            100% {
                left: 200%;
            }
        }

        @keyframes countUp {
            from {
                opacity: 0;
                transform: scale(0.8);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        .reveal-left {
            opacity: 0;
            transform: translateX(-40px);
            transition: all 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal-left.active {
            opacity: 1;
            transform: translateX(0);
        }

        .reveal-right {
            opacity: 0;
            transform: translateX(40px);
            transition: all 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal-right.active {
            opacity: 1;
            transform: translateX(0);
        }

        /* ── TICKER ── */
        .ticker-bar {
            background: var(--red-700);
            padding: 8px 0;
            overflow: hidden;
            white-space: nowrap;
        }

        .ticker-track {
            display: inline-flex;
            gap: 60px;
            animation: ticker 30s linear infinite;
        }

        .ticker-item {
            font-family: 'DM Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.85);
        }

        .ticker-item span {
            color: rgba(255, 255, 255, 0.4);
            margin: 0 8px;
        }

        /* ── HEADER ── */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 500;
            transition: all 0.4s ease;
        }

        header.scrolled {
            background: rgba(6, 0, 0, 0.95);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
        }

        .nav-inner {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--red-700), var(--red-500));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            color: white;
        }

        .logo-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--text);
            line-height: 1;
        }

        .logo-text em {
            color: var(--red-400);
            font-style: normal;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 32px;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-muted);
            font-size: 0.82rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: var(--text);
        }

        .nav-cta {
            background: var(--red-700);
            color: white !important;
            padding: 8px 20px;
            border-radius: 4px;
            transition: background 0.2s !important;
        }

        .nav-cta:hover {
            background: var(--red-600) !important;
            color: white !important;
        }

        /* ── HERO ── */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 120px 40px 80px;
            overflow: hidden;
        }

        /* Background layers */
        .hero-bg {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 20% 50%, rgba(100, 0, 0, 0.18) 0%, transparent 60%),
                radial-gradient(ellipse 60% 80% at 80% 20%, rgba(60, 0, 0, 0.12) 0%, transparent 50%),
                linear-gradient(180deg, #0D0000 0%, #060606 100%);
        }

        .hero-grid {
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(139, 0, 0, 0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(139, 0, 0, 0.06) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
        }

        /* Floating orbs */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
        }

        .orb-1 {
            width: 400px;
            height: 400px;
            background: rgba(120, 0, 0, 0.15);
            top: 10%;
            left: -5%;
            animation: float 8s ease-in-out infinite;
        }

        .orb-2 {
            width: 300px;
            height: 300px;
            background: rgba(80, 0, 0, 0.1);
            bottom: 20%;
            right: 5%;
            animation: float 10s ease-in-out infinite 2s;
        }

        .orb-3 {
            width: 200px;
            height: 200px;
            background: rgba(180, 0, 0, 0.08);
            top: 50%;
            left: 50%;
            animation: float 6s ease-in-out infinite 4s;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .hero-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(139, 0, 0, 0.15);
            border: 1px solid var(--border-hot);
            padding: 6px 14px;
            border-radius: 3px;
            font-family: 'DM Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--red-300);
            margin-bottom: 28px;
            animation: fadeIn 0.6s ease-out;
        }

        .hero-label::before {
            content: '';
            width: 6px;
            height: 6px;
            background: var(--red-400);
            border-radius: 50%;
            animation: pulse-glow 2s infinite;
        }

        .hero-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(3rem, 5vw, 5.5rem);
            font-weight: 300;
            line-height: 1.05;
            color: var(--text);
            margin-bottom: 24px;
            animation: fadeUp 0.8s ease-out 0.2s both;
        }

        .hero-title em {
            font-style: italic;
            color: var(--red-400);
            display: block;
        }

        .hero-title strong {
            font-weight: 700;
            display: block;
        }

        .hero-sub {
            font-size: 1rem;
            color: var(--text-muted);
            line-height: 1.8;
            max-width: 480px;
            margin-bottom: 40px;
            animation: fadeUp 0.8s ease-out 0.4s both;
        }

        .hero-actions {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            animation: fadeUp 0.8s ease-out 0.6s both;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, var(--red-700), var(--red-600));
            color: white;
            padding: 14px 32px;
            border-radius: 4px;
            font-size: 0.88rem;
            font-weight: 500;
            letter-spacing: 0.04em;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-primary::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -100%;
            width: 60%;
            height: 200%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
            animation: shimmer 3s infinite;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(139, 0, 0, 0.45);
            background: linear-gradient(135deg, var(--red-600), var(--red-500));
        }

        .btn-ghost {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: transparent;
            color: var(--text-muted);
            padding: 14px 28px;
            border-radius: 4px;
            font-size: 0.88rem;
            font-weight: 500;
            border: 1px solid var(--border);
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-ghost:hover {
            border-color: var(--border-hot);
            color: var(--text);
            background: rgba(139, 0, 0, 0.08);
        }

        /* ── CORE 3D CSS BOOK SYSTEM ── */
        .book-3d-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .book-3d-front {
            position: absolute;
            inset: 0;
            z-index: 5;
            transform-style: preserve-3d;
            transform-origin: left center;
            transform: translateZ(12px) rotateY(var(--book-cover-open, 0deg));
            transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            border-radius: 2px 5px 5px 2px;
            overflow: hidden;
            box-shadow: inset 4px 0 10px rgba(255, 255, 255, 0.1), inset -4px 0 10px rgba(0, 0, 0, 0.3);
            backface-visibility: hidden;
        }

        .book-3d-front img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .book-3d-front-inner {
            position: absolute;
            inset: 0;
            background: #2a0000;
            transform: rotateY(180deg) translateZ(1px);
            backface-visibility: hidden;
            box-shadow: inset 10px 0 20px rgba(0, 0, 0, 0.5);
            border-radius: 5px 2px 2px 5px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .book-3d-front-inner::after {
            content: 'PsychoSculpt';
            font-family: 'Cormorant Garamond', serif;
            font-size: 12px;
            color: var(--gold);
            opacity: 0.3;
            letter-spacing: 0.1em;
        }

        .book-3d-spine {
            position: absolute;
            width: 24px;
            height: 100%;
            left: -12px;
            background: linear-gradient(180deg, #1e0000 0%, #0d0000 100%);
            transform: rotateY(-90deg);
            border-left: 1px solid rgba(255, 255, 255, 0.06);
            border-right: 1px solid rgba(0, 0, 0, 0.4);
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.9);
        }

        .book-3d-spine::after {
            content: '✦';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: var(--red-500);
            font-size: 8px;
            opacity: 0.4;
        }

        .book-3d-pages-right {
            position: absolute;
            width: 24px;
            height: calc(100% - 6px);
            top: 3px;
            right: -12px;
            transform: rotateY(90deg);
            background: #ebe3d5;
            background-image: repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0, 0, 0, 0.05) 2px, rgba(0, 0, 0, 0.05) 4px);
            box-shadow: inset 8px 0 15px rgba(0, 0, 0, 0.15);
        }

        .book-3d-pages-top {
            position: absolute;
            height: 24px;
            width: calc(100% - 6px);
            left: 3px;
            top: -12px;
            transform: rotateX(90deg);
            background: #e4dbcb;
            background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0, 0, 0, 0.05) 2px, rgba(0, 0, 0, 0.05) 4px);
            box-shadow: inset 0 8px 15px rgba(0, 0, 0, 0.15);
        }

        .book-3d-pages-bottom {
            position: absolute;
            height: 24px;
            width: calc(100% - 6px);
            left: 3px;
            bottom: -12px;
            transform: rotateX(-90deg);
            background: #dcd2bf;
            background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0, 0, 0, 0.05) 2px, rgba(0, 0, 0, 0.05) 4px);
            box-shadow: inset 0 -8px 15px rgba(0, 0, 0, 0.15);
        }

        .book-3d-back {
            position: absolute;
            inset: 0;
            background: #110000;
            transform: translateZ(-12px) rotateY(180deg);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
            border-radius: 5px 2px 2px 5px;
            border: 1px solid rgba(255, 255, 255, 0.03);
        }

        .book-3d-page-inside {
            position: absolute;
            inset: 3px 3px 3px 0;
            background: #fcf9f2;
            transform: translateZ(10px);
            border-radius: 0 4px 4px 0;
            box-shadow: inset 4px 0 10px rgba(0, 0, 0, 0.15), 0 0 5px rgba(0, 0, 0, 0.05);
            padding: 14px 10px;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            border-left: 1px solid rgba(0, 0, 0, 0.12);
        }

        .book-3d-page-inside::before {
            content: 'CHAPTER I\n\nTHE SHADOW SELF\n\nTo control the mind of another, one must master the art of silence. What is unseen cannot be fought. What is unheard cannot be answered.\n\nEvery human mind holds dark desires, hidden vulnerabilities, and silent fears...';
            font-family: 'Cormorant Garamond', serif;
            font-size: 5px;
            line-height: 1.4;
            color: #332b21;
            white-space: pre-wrap;
            display: block;
            opacity: 0.8;
            transform: scale(0.95);
            transform-origin: top left;
        }

        /* ── HERO BOOK STACK 3D ── */
        .hero-visual {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: fadeIn 1s ease-out 0.3s both;
        }

        .book-stack-3d {
            position: relative;
            width: 280px;
            height: 380px;
            perspective: 1500px;
            transform-style: preserve-3d;
        }

        .stack-card-3d {
            position: absolute;
            width: 200px;
            height: 280px;
            transform-style: preserve-3d;
            transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
        }

        .stack-card-3d:nth-child(1) {
            top: 60px;
            left: 80px;
            --base-rotY: 15deg;
            --base-rotX: 8deg;
            --base-rotZ: 8deg;
            --base-transZ: -40px;
            z-index: 1;
        }

        .stack-card-3d:nth-child(2) {
            top: 30px;
            left: 40px;
            --base-rotY: 5deg;
            --base-rotX: 5deg;
            --base-rotZ: 3deg;
            --base-transZ: -20px;
            z-index: 2;
        }

        .stack-card-3d:nth-child(3) {
            top: 0;
            left: 0;
            --base-rotY: -8deg;
            --base-rotX: 3deg;
            --base-rotZ: -2deg;
            --base-transZ: 0px;
            z-index: 3;
        }

        .stack-card-3d {
            transform:
                translateZ(calc(var(--base-transZ) + var(--scroll-drift-z, 0px))) translateX(var(--scroll-drift-x, 0px)) translateY(var(--scroll-drift-y, 0px)) rotateX(calc(var(--base-rotX) + var(--scroll-rot-x, 0deg))) rotateY(calc(var(--base-rotY) + var(--scroll-rot-y, 0deg))) rotateZ(calc(var(--base-rotZ) + var(--scroll-rot-z, 0deg)));
        }

        @keyframes float3D {

            0%,
            100% {
                transform: translateZ(calc(var(--base-transZ) + var(--scroll-drift-z, 0px))) translateX(var(--scroll-drift-x, 0px)) translateY(calc(var(--scroll-drift-y, 0px) - 6px)) rotateX(calc(var(--base-rotX) + var(--scroll-rot-x, 0deg))) rotateY(calc(var(--base-rotY) + var(--scroll-rot-y, 0deg))) rotateZ(calc(var(--base-rotZ) + var(--scroll-rot-z, 0deg)));
            }

            50% {
                transform: translateZ(calc(var(--base-transZ) + var(--scroll-drift-z, 0px))) translateX(var(--scroll-drift-x, 0px)) translateY(calc(var(--scroll-drift-y, 0px) + 6px)) rotateX(calc(var(--base-rotX) + var(--scroll-rot-x, 0deg))) rotateY(calc(var(--base-rotY) + var(--scroll-rot-y, 0deg))) rotateZ(calc(var(--base-rotZ) + var(--scroll-rot-z, 0deg)));
            }
        }

        .stack-card-3d:nth-child(3) {
            animation: float3D 6s ease-in-out infinite;
        }

        .hero-stats {
            display: flex;
            gap: 24px;
            margin-top: 48px;
            animation: fadeUp 0.8s ease-out 0.8s both;
        }

        .stat-item {
            text-align: center;
        }

        .stat-num {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 600;
            color: var(--red-400);
            display: block;
            line-height: 1;
        }

        .stat-label {
            font-size: 0.7rem;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-top: 4px;
            display: block;
        }

        .stat-divider {
            width: 1px;
            background: var(--border);
        }

        /* ── SEARCH STRIP ── */
        .search-strip {
            background: var(--bg-2);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 30px 40px;
        }

        .search-inner {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .search-wrap {
            flex: 1;
            position: relative;
        }

        .search-wrap i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-dim);
            font-size: 0.85rem;
        }

        .search-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 14px 18px 14px 44px;
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            transition: all 0.3s;
        }

        .search-input::placeholder {
            color: var(--text-dim);
        }

        .search-input:focus {
            outline: none;
            border-color: var(--red-700);
            background: rgba(139, 0, 0, 0.05);
        }

        .filter-pills {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .pill {
            padding: 8px 16px;
            border-radius: 3px;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.2s;
        }

        .pill:hover,
        .pill.active {
            background: var(--red-700);
            border-color: var(--red-700);
            color: white;
        }

        /* ── SECTION HEADERS ── */
        .section {
            padding: 100px 40px;
        }

        .sec-header {
            max-width: 1400px;
            margin: 0 auto 60px;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
        }

        .sec-label {
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--red-600);
            display: block;
            margin-bottom: 12px;
        }

        .sec-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2rem, 3vw, 3rem);
            font-weight: 300;
            color: var(--text);
            line-height: 1.1;
        }

        .sec-title em {
            font-style: italic;
            color: var(--red-400);
        }

        .sec-count {
            font-family: 'DM Mono', monospace;
            font-size: 0.75rem;
            color: var(--text-dim);
            letter-spacing: 0.05em;
        }

        /* ── FEATURED BANNER ── */
        .featured-banner {
            background: linear-gradient(135deg, var(--bg-2) 0%, rgba(80, 0, 0, 0.3) 50%, var(--bg-2) 100%);
            border: 1px solid var(--border-hot);
            border-radius: 8px;
            padding: 48px 56px;
            margin: 0 auto 100px;
            max-width: 1400px;
            display: grid;
            grid-template-columns: auto 1fr auto;
            gap: 48px;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .featured-banner::before {
            content: 'FEATURED';
            position: absolute;
            top: 20px;
            right: 30px;
            font-family: 'DM Mono', monospace;
            font-size: 0.6rem;
            letter-spacing: 0.2em;
            color: var(--gold);
            border: 1px solid var(--gold);
            padding: 3px 8px;
            border-radius: 2px;
        }

        .featured-banner::after {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 250px;
            height: 250px;
            background: radial-gradient(circle, rgba(180, 0, 0, 0.12), transparent 70%);
            pointer-events: none;
        }

        .featured-img-3d-wrap {
            width: 130px;
            height: 185px;
            perspective: 1200px;
            transform-style: preserve-3d;
            flex-shrink: 0;
        }

        .featured-book-3d {
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            transform: rotateY(-20deg) rotateX(15deg) rotateZ(-3deg);
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .featured-img-3d-wrap:hover .featured-book-3d {
            transform: rotateY(15deg) rotateX(10deg) rotateZ(0deg) scale(1.08);
        }

        .featured-meta .tag {
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--red-400);
            display: block;
            margin-bottom: 10px;
        }

        .featured-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 600;
            color: var(--text);
            line-height: 1.2;
            margin-bottom: 12px;
        }

        .featured-author {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        .featured-desc {
            font-size: 0.88rem;
            color: var(--text-dim);
            line-height: 1.7;
            max-width: 500px;
        }

        .featured-actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
            flex-shrink: 0;
        }

        /* ── BOOKS GRID ── */
        .books-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
            gap: 16px;
        }

        .book-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            position: relative;
            cursor: pointer;
        }

        .book-card:hover {
            border-color: var(--border-hot);
            transform: translateY(-6px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 30px rgba(139, 0, 0, 0.15);
        }

        /* ── TIP CARD ── */
        .tip-card-container {
            max-width: 1400px;
            margin: 0 auto 60px;
            padding: 0 40px;
        }

        .tip-card {
            background: rgba(15, 0, 0, 0.4);
            border: 1px solid rgba(212, 0, 0, 0.2);
            border-radius: 8px;
            padding: 30px 40px;
            display: flex;
            align-items: center;
            gap: 30px;
            backdrop-filter: blur(10px);
            box-shadow: inset 0 0 20px rgba(139, 0, 0, 0.1), 0 10px 30px rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
        }

        .tip-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--red-500), transparent);
        }

        .tip-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-shrink: 0;
            width: 80px;
        }

        .tip-icon {
            font-size: 2.2rem;
            color: var(--red-400);
            margin-bottom: 8px;
            filter: drop-shadow(0 0 10px rgba(212, 0, 0, 0.4));
        }

        .tip-title {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--text-dim);
            text-align: center;
        }

        .tip-body {
            flex: 1;
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .tip-fade-out {
            opacity: 0;
            transform: translateX(-10px);
        }

        .tip-body h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            color: var(--text);
            margin-bottom: 10px;
        }

        .tip-desc {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 16px;
        }

        .tip-defense {
            background: rgba(0, 0, 0, 0.4);
            border-left: 2px solid var(--gold);
            padding: 12px 16px;
            border-radius: 0 4px 4px 0;
            font-size: 0.85rem;
        }

        .defense-label {
            color: var(--gold);
            font-family: 'DM Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-size: 0.75rem;
            margin-right: 8px;
        }

        .tip-next-btn {
            align-self: center;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .book-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 3;
            font-family: 'DM Mono', monospace;
            font-size: 0.6rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 8px;
            border-radius: 2px;
            background: var(--red-700);
            color: white;
        }

        .book-badge.gold {
            background: var(--gold);
            color: #1a0000;
        }

        .book-badge.new {
            background: rgba(0, 200, 100, 0.8);
        }

        .book-img-wrap {
            aspect-ratio: 2/3;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #150000, #0a0000);
        }

        .book-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .book-card:hover .book-img-wrap img {
            transform: scale(1.06);
        }

        .book-img-wrap::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 2;
            background: radial-gradient(circle at var(--sheen-x, 50%) var(--sheen-y, 50%), rgba(255, 255, 255, 0.15) 0%, transparent 60%);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .book-card:hover .book-img-wrap::after {
            opacity: 1;
        }

        .book-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.2) 50%, transparent 100%);
            display: flex;
            align-items: flex-end;
            padding: 20px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .book-card:hover .book-overlay {
            opacity: 1;
        }

        .overlay-btn {
            width: 100%;
            padding: 10px;
            background: var(--red-700);
            color: white;
            border: none;
            border-radius: 3px;
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
            text-align: center;
        }

        .overlay-btn:hover {
            background: var(--red-600);
        }

        .book-body {
            padding: 20px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .book-category {
            font-family: 'DM Mono', monospace;
            font-size: 0.6rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--red-600);
            margin-bottom: 8px;
        }

        .book-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--text);
            line-height: 1.3;
            margin-bottom: 6px;
        }

        .book-author {
            font-size: 0.78rem;
            color: var(--text-dim);
            margin-bottom: 16px;
        }

        .book-rating {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 16px;
        }

        .stars {
            color: var(--gold);
            font-size: 0.7rem;
        }

        .rating-count {
            font-size: 0.7rem;
            color: var(--text-dim);
        }

        .btn-row {
            display: flex;
            gap: 8px;
            margin-top: auto;
        }

        .dl-btn {
            flex: 1;
            padding: 9px 12px;
            border-radius: 3px;
            font-size: 0.75rem;
            font-weight: 500;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .dl-btn-primary {
            background: linear-gradient(135deg, var(--red-800), var(--red-700));
            color: white;
        }

        .dl-btn-primary:hover {
            background: linear-gradient(135deg, var(--red-700), var(--red-600));
            transform: translateY(-1px);
        }

        .dl-btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-muted);
            border: 1px solid var(--border);
        }

        .dl-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--border-hot);
            color: var(--text);
        }

        /* ── CATEGORIES SECTION ── */
        .categories-section {
            padding: 100px 40px;
            background: linear-gradient(180deg, transparent, rgba(80, 0, 0, 0.05), transparent);
        }

        .categories-grid {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
        }

        .cat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 28px 24px;
            text-align: center;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            text-decoration: none;
            display: block;
            perspective: 800px;
            transform-style: preserve-3d;
            position: relative;
            overflow: hidden;
        }

        .cat-card:hover {
            border-color: var(--border-hot);
            background: rgba(80, 0, 0, 0.12);
            transform: translateY(-5px) rotateY(10deg) rotateX(5deg);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), 0 0 20px rgba(139, 0, 0, 0.15);
        }

        /* Border trace shimmer overlay on card hover */
        .cat-card::before {
            content: '';
            position: absolute;
            inset: -1px;
            background: linear-gradient(90deg, transparent, var(--red-500), transparent);
            background-size: 200% auto;
            border-radius: 6px;
            z-index: -1;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .cat-card:hover::before {
            opacity: 1;
            animation: border-trace 2s linear infinite;
        }

        @keyframes border-trace {
            0% {
                background-position: 200% center;
            }

            100% {
                background-position: -200% center;
            }
        }

        .cat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            margin: 0 auto 16px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(212, 0, 0, 0.08), rgba(139, 0, 0, 0.03));
            border: 1px solid rgba(255, 255, 255, 0.04);
            box-shadow: inset 0 0 15px rgba(139, 0, 0, 0.1), 0 8px 20px rgba(0, 0, 0, 0.3);
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            transform: translateZ(10px);
        }

        .cat-card:hover .cat-icon {
            background: linear-gradient(135deg, rgba(212, 0, 0, 0.15), rgba(139, 0, 0, 0.08));
            border-color: rgba(212, 0, 0, 0.25);
            box-shadow: inset 0 0 25px rgba(212, 0, 0, 0.15), 0 12px 25px rgba(0, 0, 0, 0.5);
            transform: translateZ(25px) scale(1.05);
        }

        .cat-icon i {
            font-size: 1.6rem;
            background: linear-gradient(135deg, var(--red-400), var(--red-600));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 2px 8px rgba(212, 0, 0, 0.4));
            transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
        }

        .cat-card:hover .cat-icon i {
            transform: scale(1.15) rotateY(15deg);
            filter: drop-shadow(0 4px 15px rgba(212, 0, 0, 0.7));
        }

        .cat-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 6px;
        }

        .cat-count {
            font-size: 0.72rem;
            color: var(--text-dim);
            font-family: 'DM Mono', monospace;
        }

        /* ── TRUST STRIP ── */
        .trust-strip {
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 32px 40px;
            background: var(--bg-2);
        }

        .trust-inner {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
            text-align: center;
        }

        .trust-item i {
            font-size: 1.4rem;
            color: var(--red-600);
            margin-bottom: 10px;
            display: block;
        }

        .trust-item strong {
            display: block;
            font-size: 0.88rem;
            color: var(--text);
            margin-bottom: 4px;
        }

        .trust-item span {
            font-size: 0.75rem;
            color: var(--text-dim);
        }

        /* ── QUOTE SECTION ── */
        .quote-section {
            padding: 100px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .quote-section::before {
            content: '"';
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'Cormorant Garamond', serif;
            font-size: 300px;
            color: rgba(139, 0, 0, 0.04);
            line-height: 1;
            pointer-events: none;
        }

        .quote-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(1.8rem, 3vw, 2.8rem);
            font-style: italic;
            font-weight: 300;
            color: var(--text);
            max-width: 900px;
            margin: 0 auto 24px;
            line-height: 1.4;
            position: relative;
        }

        .quote-author {
            font-family: 'DM Mono', monospace;
            font-size: 0.75rem;
            letter-spacing: 0.2em;
            color: var(--red-600);
            text-transform: uppercase;
        }

        /* ── CONTACT SECTION ── */
        .contact-section {
            padding: 100px 40px;
            background: linear-gradient(180deg, transparent, rgba(60, 0, 0, 0.1));
        }

        .contact-grid {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .contact-info .kicker {
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--red-600);
            display: block;
            margin-bottom: 16px;
        }

        .contact-info h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.8rem;
            font-weight: 300;
            color: var(--text);
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .contact-info h2 em {
            font-style: italic;
            color: var(--red-400);
        }

        .contact-info p {
            font-size: 0.92rem;
            color: var(--text-muted);
            line-height: 1.8;
            margin-bottom: 32px;
        }

        .contact-perks {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .perk {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .perk i {
            color: var(--red-500);
            font-size: 0.85rem;
        }

        .contact-form-wrap {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 40px;
        }

        .form-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 6px;
        }

        .form-sub {
            font-size: 0.82rem;
            color: var(--text-dim);
            margin-bottom: 28px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-dim);
            margin-bottom: 8px;
            font-family: 'DM Mono', monospace;
        }

        .form-control {
            width: 100%;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 12px 16px;
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.88rem;
            transition: all 0.3s;
        }

        .form-control::placeholder {
            color: var(--text-dim);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--red-700);
            background: rgba(139, 0, 0, 0.05);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 100px;
        }

        .submit-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--red-700), var(--red-600));
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 0.88rem;
            font-weight: 500;
            letter-spacing: 0.04em;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 8px;
            position: relative;
            overflow: hidden;
        }

        .submit-btn::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -100%;
            width: 60%;
            height: 200%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            animation: shimmer 3s infinite 1.5s;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(139, 0, 0, 0.4);
        }

        /* ── FOOTER ── */
        footer {
            border-top: 1px solid var(--border);
            padding: 60px 40px 40px;
        }

        .footer-inner {
            max-width: 1400px;
            margin: 0 auto;
        }

        .footer-top {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 60px;
            margin-bottom: 48px;
        }

        .footer-brand .logo-text {
            font-size: 1.5rem;
            margin-bottom: 14px;
            display: block;
        }

        .footer-brand p {
            font-size: 0.82rem;
            color: var(--text-dim);
            line-height: 1.7;
            max-width: 260px;
        }

        .footer-col h4 {
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--text-dim);
            margin-bottom: 18px;
        }

        .footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .footer-col a {
            text-decoration: none;
            color: var(--text-muted);
            font-size: 0.84rem;
            transition: color 0.2s;
        }

        .footer-col a:hover {
            color: var(--red-400);
        }

        .footer-bottom {
            border-top: 1px solid var(--border);
            padding-top: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-copy {
            font-size: 0.76rem;
            color: var(--text-dim);
        }

        .footer-socials {
            display: flex;
            gap: 16px;
        }

        .footer-socials a {
            width: 34px;
            height: 34px;
            border: 1px solid var(--border);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dim);
            font-size: 0.8rem;
            text-decoration: none;
            transition: all 0.2s;
        }

        .footer-socials a:hover {
            border-color: var(--red-700);
            color: var(--red-400);
        }

        /* ── BOOK DETAIL MODAL ── */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 2000;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .modal-backdrop.open {
            opacity: 1;
            pointer-events: all;
        }

        .modal-scrim {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            cursor: pointer;
        }

        .modal-panel {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 900px;
            max-height: 90vh;
            background: #0e0202;
            border: 1px solid var(--border-hot);
            border-bottom: none;
            border-radius: 16px 16px 0 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transform: translateY(100%);
            transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 -30px 100px rgba(139, 0, 0, 0.25), 0 -4px 0 var(--red-700);
        }

        .modal-backdrop.open .modal-panel {
            transform: translateY(0);
        }

        .modal-drag-handle {
            width: 40px;
            height: 4px;
            background: var(--border-hot);
            border-radius: 2px;
            margin: 14px auto 0;
            flex-shrink: 0;
        }

        .modal-body {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 0;
            overflow-y: auto;
            flex: 1;
            padding: 32px 40px 40px;
            gap: 40px;
        }

        /* ── OTP MODAL ── */
        .otp-panel {
            max-width: 450px;
            margin: auto;
            border: 1px solid var(--border-hot);
            box-shadow: 0 30px 100px rgba(139, 0, 0, 0.4), inset 0 0 30px rgba(139, 0, 0, 0.1);
            background: linear-gradient(135deg, var(--surface) 0%, rgba(15, 0, 0, 0.95) 100%);
            backdrop-filter: blur(20px);
        }

        .otp-body {
            padding: 40px;
            text-align: center;
        }

        .otp-icon {
            font-size: 2.5rem;
            color: var(--red-500);
            margin-bottom: 16px;
            filter: drop-shadow(0 0 15px rgba(212, 0, 0, 0.4));
        }

        .otp-subtitle {
            font-size: 0.85rem;
            color: var(--gold);
            margin-bottom: 24px;
        }

        .otp-desc {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 24px;
            line-height: 1.5;
        }

        .otp-inputs {
            display: flex;
            gap: 12px;
            justify-content: center;
            margin-bottom: 24px;
        }

        .otp-box {
            width: 50px;
            height: 60px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border);
            border-radius: 6px;
            text-align: center;
            font-size: 1.5rem;
            color: var(--text);
            font-family: 'DM Mono', monospace;
            transition: all 0.3s;
        }

        .otp-box:focus {
            border-color: var(--red-500);
            box-shadow: 0 0 15px rgba(139, 0, 0, 0.4);
            outline: none;
        }

        .otp-error {
            color: var(--red-400);
            font-size: 0.8rem;
            margin-top: 16px;
            height: 16px;
        }

        .otp-resend {
            margin-top: 16px;
            font-size: 0.8rem;
        }

        .otp-resend a {
            color: var(--text-dim);
            text-decoration: underline;
        }

        .w-100 {
            width: 100%;
            justify-content: center;
        }

        .otp-success-icon {
            font-size: 3rem;
            color: #4caf50;
            margin-bottom: 16px;
            filter: drop-shadow(0 0 15px rgba(76, 175, 80, 0.4));
        }

        .modal-cover {
            width: 220px;
            flex-shrink: 0;
        }

        .modal-cover-img {
            width: 100%;
            aspect-ratio: 2/3;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(139, 0, 0, 0.3);
            position: relative;
        }

        .modal-cover-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .modal-cover:hover .modal-cover-img img {
            transform: scale(1.04);
        }

        .modal-cover-glow {
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            width: 80%;
            height: 40px;
            background: radial-gradient(ellipse, rgba(180, 0, 0, 0.5), transparent 70%);
            filter: blur(10px);
        }

        .modal-info {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .modal-category {
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--red-500);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .modal-category::before {
            content: '';
            width: 20px;
            height: 1px;
            background: var(--red-600);
            display: inline-block;
        }

        .modal-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(1.8rem, 3vw, 2.6rem);
            font-weight: 600;
            color: var(--text);
            line-height: 1.1;
            margin-bottom: 8px;
        }

        .modal-author {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        .modal-rating {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }

        .modal-rating .stars {
            font-size: 0.9rem;
            color: var(--gold);
        }

        .modal-rating .count {
            font-size: 0.8rem;
            color: var(--text-dim);
            font-family: 'DM Mono', monospace;
        }

        .modal-desc {
            font-size: 0.93rem;
            color: var(--text-muted);
            line-height: 1.85;
            margin-bottom: 28px;
            flex: 1;
        }

        .modal-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 28px;
        }

        .modal-tag {
            padding: 5px 12px;
            border: 1px solid var(--border);
            border-radius: 2px;
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-dim);
        }

        .modal-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .modal-close-btn {
            position: absolute;
            top: 18px;
            right: 20px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-muted);
            font-size: 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            z-index: 2;
        }

        .modal-close-btn:hover {
            border-color: var(--red-600);
            color: var(--red-400);
            background: rgba(139, 0, 0, 0.1);
        }

        .modal-formats {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
        }

        .format-badge {
            padding: 4px 10px;
            border-radius: 2px;
            background: rgba(139, 0, 0, 0.15);
            border: 1px solid var(--border-hot);
            font-family: 'DM Mono', monospace;
            font-size: 0.6rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--red-300);
        }

        @keyframes modalReveal {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-backdrop.open .modal-info>* {
            animation: modalReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .modal-backdrop.open .modal-info>*:nth-child(1) {
            animation-delay: 0.15s;
        }

        .modal-backdrop.open .modal-info>*:nth-child(2) {
            animation-delay: 0.2s;
        }

        .modal-backdrop.open .modal-info>*:nth-child(3) {
            animation-delay: 0.25s;
        }

        .modal-backdrop.open .modal-info>*:nth-child(4) {
            animation-delay: 0.3s;
        }

        .modal-backdrop.open .modal-info>*:nth-child(5) {
            animation-delay: 0.35s;
        }

        .modal-backdrop.open .modal-info>*:nth-child(6) {
            animation-delay: 0.4s;
        }

        .modal-backdrop.open .modal-info>*:nth-child(7) {
            animation-delay: 0.45s;
        }

        .modal-cover {
            animation: modalReveal 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
        }

        /* ── HAMBURGER ── */
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px;
        }

        .hamburger span {
            width: 22px;
            height: 2px;
            background: var(--text);
            border-radius: 2px;
            transition: all 0.3s;
        }

        @media (max-width: 768px) {
            .hamburger {
                display: flex;
            }

            .nav-links {
                position: fixed;
                top: 80px;
                left: 0;
                right: 0;
                background: rgba(6, 0, 0, 0.98);
                flex-direction: column;
                padding: 40px;
                gap: 24px;
                border-bottom: 1px solid var(--border);
                transform: translateY(-100%);
                opacity: 0;
                pointer-events: none;
                transition: all 0.35s ease;
            }

            .nav-links.active {
                transform: translateY(0);
                opacity: 1;
                pointer-events: all;
                display: flex;
            }
        }

        /* ── BACK TO TOP ── */
        #backToTop {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 999;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--red-700);
            color: white;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(139, 0, 0, 0.4);
            display: none;
        }

        #backToTop:hover {
            background: var(--red-600);
            transform: translateY(-2px);
        }

        /* ── SORT SELECT ── */
        .sort-select {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 8px 12px;
            color: var(--text-muted);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.75rem;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            flex-shrink: 0;
        }

        .sort-select:focus {
            outline: none;
            border-color: var(--red-700);
        }

        .sort-select option {
            background: var(--bg);
            color: var(--text);
        }

        /* ── MEDIA QUERIES ── */
        @media (max-width: 1024px) {
            .hero-content {
                grid-template-columns: 1fr;
                gap: 60px;
            }

            .hero-visual {
                display: none;
            }

            .featured-banner {
                grid-template-columns: auto 1fr;
            }

            .featured-actions {
                display: none;
            }

            .footer-top {
                grid-template-columns: 1fr 1fr;
                gap: 40px;
            }

            .contact-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .trust-inner {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .nav-inner {
                padding: 16px 20px;
            }

            .hero {
                padding: 100px 20px 60px;
            }

            .section,
            .categories-section,
            .contact-section {
                padding: 60px 20px;
            }

            .search-strip {
                padding: 20px;
            }

            .search-inner {
                flex-direction: column;
            }

            .ticker-bar {
                display: none;
            }

            .footer-top {
                grid-template-columns: 1fr;
                gap: 32px;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 16px;
                text-align: center;
            }

            .featured-banner {
                grid-template-columns: 1fr;
                padding: 28px;
            }

            .featured-img {
                display: none;
            }

            .sec-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .trust-inner {
                grid-template-columns: 1fr 1fr;
                gap: 20px;
            }

            .hero-stats {
                gap: 16px;
            }

            .books-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .hero-title {
                font-size: clamp(2rem, 10vw, 3rem);
            }

            .hero-sub {
                font-size: 0.85rem;
                max-width: 100%;
            }

            .hero-stats {
                gap: 12px;
                flex-wrap: wrap;
            }

            .stat-num {
                font-size: 1.3rem;
            }

            .stat-label {
                font-size: 0.55rem;
            }

            .hero-label {
                font-size: 0.6rem;
                padding: 5px 10px;
                margin-bottom: 20px;
            }

            .hero-actions {
                flex-direction: column;
            }

            .hero-actions .btn-primary,
            .hero-actions .btn-ghost {
                width: 100%;
                justify-content: center;
            }

            .book-body {
                padding: 12px;
            }

            .book-title {
                font-size: 0.9rem;
            }

            .book-author {
                font-size: 0.68rem;
                margin-bottom: 8px;
            }

            .book-rating {
                margin-bottom: 8px;
            }

            .stars {
                font-size: 0.55rem;
            }

            .rating-count {
                font-size: 0.55rem;
            }

            .dl-btn {
                font-size: 0.6rem;
                padding: 7px 8px;
            }

            .book-badge {
                font-size: 0.5rem;
                padding: 3px 6px;
                top: 6px;
                left: 6px;
            }

            .featured-banner {
                padding: 20px;
                gap: 16px;
            }

            .featured-img-3d-wrap {
                display: none;
            }

            .featured-title {
                font-size: 1.3rem;
            }

            .featured-desc {
                font-size: 0.82rem;
            }

            .featured-meta .tag {
                font-size: 0.55rem;
            }

            .tip-card {
                flex-direction: column;
                align-items: flex-start;
                padding: 24px;
                gap: 16px;
            }

            .tip-header {
                width: 100%;
                flex-direction: row;
                gap: 12px;
                align-items: center;
            }

            .tip-icon {
                margin-bottom: 0;
                font-size: 1.6rem;
            }

            .tip-title {
                font-size: 0.6rem;
                text-align: left;
            }

            .tip-body h3 {
                font-size: 1.2rem;
            }

            .tip-desc {
                font-size: 0.85rem;
            }

            .tip-next-btn {
                align-self: stretch;
                width: 100%;
                justify-content: center;
            }

            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .cat-card {
                padding: 20px 16px;
            }

            .cat-icon {
                width: 48px;
                height: 48px;
            }

            .cat-icon i {
                font-size: 1.2rem;
            }

            .cat-name {
                font-size: 0.95rem;
            }

            .cat-count {
                font-size: 0.65rem;
            }

            .contact-form-wrap {
                padding: 24px;
            }

            .form-title {
                font-size: 1.3rem;
            }

            .modal-body {
                grid-template-columns: 1fr;
                padding: 24px 20px 30px;
                gap: 20px;
            }

            .modal-cover {
                width: 120px;
                margin: 0 auto;
            }

            .modal-title {
                font-size: 1.3rem;
            }

            .modal-desc {
                font-size: 0.85rem;
            }

            .modal-actions {
                flex-direction: column;
            }

            .modal-actions .btn-primary,
            .modal-actions .btn-ghost {
                width: 100%;
                justify-content: center;
            }

            .otp-body {
                padding: 28px 20px;
            }

            .otp-box {
                width: 44px;
                height: 52px;
                font-size: 1.2rem;
            }

            .otp-inputs {
                gap: 8px;
            }

            .trust-item i {
                font-size: 1.1rem;
            }

            .trust-item strong {
                font-size: 0.8rem;
            }

            .trust-item span {
                font-size: 0.65rem;
            }

            .sec-title {
                font-size: 1.5rem;
            }

            footer {
                padding: 40px 20px 30px;
            }

            .quote-section {
                padding: 60px 20px;
            }

            .quote-text {
                font-size: 1.4rem;
            }

            #backToTop {
                bottom: 16px;
                right: 16px;
                width: 38px;
                height: 38px;
            }
        }

        @media (max-width: 480px) {
            .nav-inner {
                padding: 12px 12px;
            }

            .logo-text {
                font-size: 1rem;
            }

            .logo-icon {
                width: 26px;
                height: 26px;
                font-size: 11px;
            }

            .hero {
                padding: 80px 12px 40px;
            }

            .hero-title {
                font-size: clamp(1.6rem, 11vw, 2.2rem);
            }

            .hero-sub {
                font-size: 0.8rem;
            }

            .hero-stats {
                gap: 6px;
            }

            .stat-divider {
                display: none;
            }

            .stat-num {
                font-size: 1.1rem;
            }

            .section,
            .categories-section,
            .contact-section {
                padding: 36px 12px;
            }

            .search-strip {
                padding: 12px;
            }

            .search-inner {
                gap: 8px;
            }

            .search-input {
                padding: 10px 12px 10px 36px;
                font-size: 0.82rem;
            }

            .search-wrap i {
                left: 12px;
                font-size: 0.75rem;
            }

            .pill {
